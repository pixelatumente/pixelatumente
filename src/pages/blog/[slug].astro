---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const allPosts = await getCollection('blog');
const slug = Astro.params.slug;
const post = allPosts.find(p => p.id.replace(/\.md$/, '') === slug);
if (!post) throw new Error(`Post no encontrado: ${slug}`);
const { Content } = await render(post);

const title = `${post.data.title} — Pixelatumente`;
const ogImage = 'https://pixelatumente.es/og-default.png';
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  author: {
    "@type": "Person",
    name: "Daniel Blasco",
    url: "https://pixelatumente.es/"
  },
  publisher: {
    "@type": "Organization",
    name: "Pixelatumente",
    url: "https://pixelatumente.es/"
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://pixelatumente.es/blog/${slug}/`
  }
});

const canonical = `https://pixelatumente.es/blog/${slug}/`;
---

<BaseLayout
  title={title}
  description={post.data.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  canonical={canonical}
>
  <div class="blog-post-page">
    <header class="blog-post-header">
      <div class="container">
        <p class="blog-post-meta">{post.data.date}</p>
        <h1>{post.data.title}</h1>
      </div>
    </header>

    <div class="container blog-post-content">
      <article class="prose">
        <Content />
      </article>

      <footer class="blog-post-footer">
        <a href="/blog/" class="back-to-blog">← Volver al blog</a>
      </footer>
    </div>
  </div>
</BaseLayout>
