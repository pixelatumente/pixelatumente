---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

function postSlug(post) {
  return post.id.replace(/\.md$/, '');
}

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date) - new Date(a.data.date));

const title = 'Blog — Pixelatumente';
const description = 'Artículos, guías y notas sobre SEO, copy, herramientas y lo que voy descubriendo.';
---

<BaseLayout title={title} description={description}>
  <div class="blog-list-page">
    <header class="blog-list-header">
      <div class="container">
        <h1>Blog</h1>
        <p>Artículos, guías y notas sobre SEO, copy, herramientas y lo que voy descubriendo.</p>
      </div>
    </header>

    <div class="container">
      <div class="blog-list-grid">
        {sortedPosts.map(function(post) {
          return (
            <article class="blog-list-card">
              <p class="blog-list-meta">{post.data.date}</p>
              <h3><a href={`/blog/${postSlug(post)}/`}>{post.data.title}</a></h3>
              <p class="blog-list-excerpt">{post.data.description}</p>
              <a href={`/blog/${postSlug(post)}/`} class="read-more">Leer →</a>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
